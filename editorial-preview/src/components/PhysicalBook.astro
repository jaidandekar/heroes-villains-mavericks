---
import css from './physical-book.css?raw';
const { cover, base = '../', pose = [35, -8, -12], color = '#203c51', depth = 14, stack = [], variant = 0, includeStyles = true, format, stackLayout = [] } = Astro.props;
---
<span class="physical-book" data-format={format} aria-hidden="true" style={'--book-x: ' + pose[0] + 'deg; --book-y: ' + pose[1] + 'deg; --book-z: ' + pose[2] + 'deg; --book-color: ' + color + '; --book-depth: min(' + (depth / 8) + 'vw, ' + depth + 'px)'}>
  <span class="physical-book-shadow"></span>
  <span class="physical-book-object">
  {stack.map((item, index) => <span class="physical-book-under" style={'--under-depth: ' + (item.physical?.depth ?? 7) + 'px; --under-drop: ' + (stack.slice(0,index+1).reduce((sum,book) => sum + (book.physical?.depth ?? 7) + 2,0)) + 'px; --under-z: ' + (stackLayout[index]?.[0] ?? [5,-7,9,-4,6,-9,4,-6][(variant + index * 3) % 8]) + 'deg; --under-x: ' + (stackLayout[index]?.[1] ?? ((variant % 3 - 1) * 2 + (index ? -2 : 2))) + '%; --under-y: ' + (stackLayout[index]?.[2] ?? (index ? 4 : 2)) + '%; --under-level: ' + (index + 1)}>
    <span class="physical-book-under-pages"></span>
    <img src={base + item.cover} alt="" loading="lazy" />
  </span>)}
  <span class="physical-book-lift">
    <span class="physical-book-back"></span>
    <span class="physical-book-pages physical-book-bottom"></span>
    <span class="physical-book-pages physical-book-right"></span>
    <span class="physical-book-spine"></span>
    {format && <span class="physical-book-staples"></span>}
    <span class="physical-book-endpaper"><span class="physical-book-comic-page">{Array.from({ length: 6 }, () => <span class="physical-book-comic-panel"></span>)}</span></span>
    <img class="physical-book-cover" src={base + cover} alt="" loading="lazy" />
    {format === 'comic' && <span class="physical-book-flex-cover">{Array.from({length: 24}, (_,index) => <span class="physical-book-cover-strip" style={'--strip: ' + index + '; --bend: ' + ((index / 23) ** 1.5).toFixed(4) + '; --curl-offset: ' + (Math.sin(.55 * index / 24) / .55 - index / 24).toFixed(7) + '; --curl-z: ' + ((1 - Math.cos(.55 * index / 24)) / .55).toFixed(5) + '; --curl-angle: ' + (-.55 * index / 24 * 180 / Math.PI).toFixed(3) + 'deg; background-image: url("' + base + cover + '")'}></span>)}</span>}
    {format && <span class="physical-book-cover-finish"></span>}
  </span></span>
</span>
{includeStyles && <style is:inline set:html={css}></style>}
