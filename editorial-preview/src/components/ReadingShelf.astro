---
import RequiredReadingCards from './RequiredReadingCards.astro';
import css from './reading-shelf.css?raw';
const books = [
  { slug: 'shelf-last-ronin', title: 'Teenage Mutant Ninja Turtles: The Last Ronin', creators: 'Kevin Eastman, Peter Laird, and Tom Waltz', cover: 'media/shelf-last-ronin.jpg' },
  { slug: 'shelf-sinestro', title: 'Green Lantern Vol. 1: Sinestro', creators: 'Geoff Johns and Doug Mahnke', cover: 'media/shelf-sinestro.jpg' },
  { slug: 'shelf-batman-spawn', title: 'Batman/Spawn: The Classic Collection', creators: 'Doug Moench, Frank Miller, Todd McFarlane, and others', cover: 'media/shelf-batman-spawn.jpg' },
  { slug: 'shelf-court-of-owls', title: 'Batman Vol. 1: The Court of Owls', creators: 'Scott Snyder and Greg Capullo', cover: 'media/shelf-court-of-owls.jpg' },
];
---
<section class="wrap section" id="shelf" aria-labelledby="bookshelf-title">
  <h2 class="shelf-col-title" id="bookshelf-title">What’s on my bookshelf</h2>
  <RequiredReadingCards runs={books} base="./" />
</section>
<style is:inline set:html={css}></style>
