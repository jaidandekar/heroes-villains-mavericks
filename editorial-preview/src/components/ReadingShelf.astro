---
import BookCard from './BookCard.astro';
import css from './reading-shelf.css?raw';
---
    <section class="wrap section" id="shelf">
      <h2 class="shelf-col-title">What’s on my bookshelf</h2>
        <div class="shelf-stories">
          <BookCard href="https://www.amazon.com/dp/1684058414" cover="media/shelf-last-ronin.jpg" external>

                <h3>Teenage Mutant Ninja Turtles: The Last Ronin</h3>
                <p class="shelf-dek">Kevin Eastman, Peter Laird, and Tom Waltz</p>

                <span class="shelf-buy">View on Amazon ↗</span>
              </BookCard>
          <BookCard href="https://www.amazon.com/dp/1401234550" cover="media/shelf-sinestro.jpg" external>

                <h3>Green Lantern Vol. 1: Sinestro</h3>
                <p class="shelf-dek">Geoff Johns and Doug Mahnke</p>

                <span class="shelf-buy">View on Amazon ↗</span>
              </BookCard>
          <BookCard href="https://www.amazon.com/dp/1779521502" cover="media/shelf-batman-spawn.jpg" external>

                <h3>Batman/Spawn: The Classic Collection</h3>
                <p class="shelf-dek">Doug Moench, Frank Miller, Todd McFarlane, and others</p>

                <span class="shelf-buy">View on Amazon ↗</span>
              </BookCard>
          <BookCard href="https://www.amazon.com/dp/1401235425" cover="media/shelf-court-of-owls.jpg" external>
                <h3>Batman Vol. 1: The Court of Owls</h3>
                <p class="shelf-dek">Scott Snyder and Greg Capullo</p>
                <span class="shelf-buy">View on Amazon ↗</span>
              </BookCard>
        </div>
    </section>

<style is:inline set:html={css}></style>
