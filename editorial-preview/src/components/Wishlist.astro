---
import ProductCard from './ProductCard.astro';
import css from './wishlist.css?raw';
import items from '../data/wishlist.json';
---
<section class="wrap section wishlist" id="wishlist" aria-labelledby="wishlist-title">
  <div class="section-head">
    <h2 id="wishlist-title">On my wishlist</h2>
    <p>Figures, apparel, and everyday finds tied to the characters I’m following.</p>
  </div>
  <ul class="wishlist-grid">
    {items.map(item => <ProductCard item={item} label={item.store} />)}
  </ul>
</section>

<style is:inline set:html={css}></style>
