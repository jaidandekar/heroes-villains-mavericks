  "fantastic-four": {
    "pitch": "The Fantastic Four are Marvel’s family of explorers. A flight through cosmic radiation gives Reed Richards, Sue Storm, Johnny Storm, and Ben Grimm extraordinary abilities and sends them toward even stranger frontiers.",
    "overview": [
      "The four come home from their flight changed in different ways. Reed can stretch his body, Sue can become invisible and project force fields, Johnny can ignite and fly, and Ben gains immense strength along with a rocky body he can’t simply switch off.",
      "Their adventures revolve around a family learning to live with those changes while exploring places that ordinary science cannot reach. Doctor Doom’s rivalry with Reed gives those discoveries a recurring personal cost. Later, the Future Foundation brings the Richards children and a new generation of problem-solvers into the story."
    ],
    "sources": [
      {
        "label": "Marvel’s Fantastic Four profile",
        "url": "https://www.marvel.com/teams-and-groups/fantastic-four/in-comics"
      },
      {
        "label": "Marvel’s Future Foundation reading guide",
        "url": "https://www.marvel.com/comics/guides/2508/the-future-foundation"
      }
    ],
    "versions": [
      {
        "slug": "ultimate-fantastic-four",
        "name": "Ultimate Fantastic Four",
        "universe": "Ultimate Marvel",
        "description": "The original Ultimate line reintroduces Reed, Sue, Johnny, and Ben as a younger team. It gives their experiments and family dynamic a new starting point, separate from the original Lee and Kirby run.",
        "firstAppearance": "Ultimate Fantastic Four #1",
        "source": "https://www.marvel.com/comics/issue/95/slug"
      },
      {
        "slug": "future-foundation",
        "name": "Future Foundation",
        "universe": "Main Marvel continuity · Team era",
        "description": "The family reorganizes after losing Johnny and invites Spider-Man into the group. The Foundation gives the Richards children and other young scientists a place to tackle problems of their own.",
        "source": "https://www.marvel.com/comics/guides/2508/the-future-foundation"
      }
    ],
    "reading": {
      "ff-worlds-greatest": {
        "note": "Read this collection for the original flight, the team’s early experiments with its powers, and the start of Doom’s rivalry with Reed. It shows how quickly the premise moves from a family crisis to stories about exploration on a much larger scale.",
        "url": "https://www.marvel.com/teams-and-groups/fantastic-four/in-comics"
      },
      "ff-hickman-2": {
        "note": "The Future Foundation changes the scale of the family story by bringing young scientists into Reed’s orbit. Since this is a second volume, readers new to Hickman’s run can use Marvel’s chronology to find an earlier starting point.",
        "url": "https://www.marvel.com/comics/guides/2508/the-future-foundation"
      },
      "ff-north": {
        "note": "The opening issues split up the team after a disaster. Ben and Alicia stumble into a time loop, while Reed and Sue encounter a town full of Doombots. The smaller mysteries give new readers a way into the family’s relationships before they learn what drove everyone apart.",
        "url": "https://www.marvel.com/comics/collection/95695/fantastic_four_by_ryan_north_vol_1_whatever_happened_to_the_fantastic_four_2022"
      }
    },
