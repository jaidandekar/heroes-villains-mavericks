{
  "batman": {
    "pitch": "Bruce Wayne is Gotham City’s masked detective. Armed with training, technology, and an obsession with justice, he hunts the criminals who prey on the city that took his parents.",
    "overview": [
      "Bruce Wayne was a child when he saw his parents murdered in Gotham. He spent years studying combat, detection, and forensic science before coming home to fight the kind of crime that had shattered his family.",
      "Batman’s partnership with James Gordon gives him an ally inside a deeply compromised police department. The Robins and the wider Bat-Family complicate his reputation as a loner: many of his most consequential stories ask what happens when he trusts someone else with the work, or when someone else has to wear the cowl."
    ],
    "sources": [
      {
        "label": "DC’s Batman profile",
        "url": "https://www.dc.com/characters/batman"
      }
    ],
    "reading": {
      "batman-year-one": {
        "note": "The story follows Bruce and James Gordon through their first year fighting corruption in Gotham. Their parallel starts make it an introduction to both Batman’s methods and the police alliance that makes them possible.",
        "url": "https://www.dc.com/characters/batman"
      },
      "batman-owls": {
        "note": "An investigation leads Bruce to a secret society whose influence predates his family’s standing in Gotham. Start here if you want a detective story that challenges Batman’s confidence that he knows his own city.",
        "url": "https://www.dc.com/blog/2026-01-21/how-to-start-reading-batman-comics"
      },
      "batman-dkr": {
        "note": "This alternate future imagines what happens when an older Bruce returns to the cowl. It is a self-contained contrast to Year One: the point is what Batman’s return does to Gotham, rather than how he learns the job.",
        "url": "https://www.dc.com/characters/batman"
      },
      "batman-zoo": {
        "note": "A young Bruce faces a gang of masked killers in a Gotham where he has neither the Wayne fortune nor Alfred in his corner. The first six issues introduce a Batman whose tactics grow out of a very different upbringing.",
        "url": "https://www.dc.com/graphic-novels/absolute-batman-2024/absolute-batman-vol-1-the-zoo"
      }
    },
