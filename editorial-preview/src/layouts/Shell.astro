---
import css from './editorial.css?raw';
import chromeCss from './site-chrome.css?raw';
import site from '../data/site.json';
import logo from '../../public/media/hvm-logo.svg?raw';
import directionCss from './collector-journal.css?raw';
const { title, description, home = './', design = false, secondaryLinks = [], guideReference = false } = Astro.props;
const brandLogo = logo.replaceAll('fill="black"', 'fill="currentColor"').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const footerLinks = [
  ['Home', 'index.html'],
  ['Character guides', 'index.html#characters'],
  ['New this week', 'index.html#weekly-releases'],
  ['My bookshelf', 'index.html#shelf'],
  ['Behind the scenes', 'index.html#lanterns-podcast'],
  ['My wishlist', 'index.html#wishlist'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content={description} />
  <title>{title} | Heroes, Villains &amp; Mavericks</title>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@8..144,100..900&amp;display=swap" rel="stylesheet" />
  <style is:inline set:html={css}></style>
</head>
<body id="top" class:list={{ 'collector-journal': design, 'guide-reference': guideReference }}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="site-navigation">
  <header class="masthead wrap site-chrome">
    <div class="identity">
      <a class="wordmark" href={home + 'index.html'} aria-label="Heroes, Villains &amp; Mavericks"><Fragment set:html={brandLogo} /></a>
      <nav aria-label="Main navigation"><a href={home + 'index.html'}>Home</a><a href={home + 'index.html#characters'}>Character guides</a></nav>
    </div>
    <a class="byline" href="https://indypendee.com/" target="_blank" rel="noopener noreferrer">by Jai Dandekar</a>
  </header>
  {secondaryLinks.length > 0 && <nav class="guide-section-nav" aria-label="Guide sections"><div class="wrap">{secondaryLinks.map(({href,label}) => <a href={href}>{label}</a>)}</div></nav>}
  </div>
  <div class="navigation-space" aria-hidden="true"></div>
  <main id="main"><slot /></main>
  <footer class="wrap footer site-footer site-chrome" aria-label="Site footer">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-mark" href={home + 'index.html'} aria-label="Heroes, Villains &amp; Mavericks home"><Fragment set:html={brandLogo} /></a>
        <p class="footer-name">Heroes, Villains &amp; Mavericks</p>
        <p class="footer-description">{site.description}</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <p class="footer-label">Explore</p>
        <ul>{footerLinks.map(([label, path]) => <li><a href={home + path}>{label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="footer-meta">
      <a href="https://indypendee.com/" target="_blank" rel="noopener noreferrer">Design &amp; editorial by Jai Dandekar <span class="link-arrow" aria-hidden="true">→</span></a>
      <a href="#top">Back to top <span class="link-arrow" aria-hidden="true">→</span></a>
    </div>
  </footer>
  {design && <style is:inline set:html={directionCss}></style>}
  <style is:inline set:html={chromeCss}></style>
  <script is:inline>
    // One sticky group keeps the two bars together, including in mobile Safari.
    const siteHeader = document.querySelector('.masthead');
    const navigation = document.querySelector('.site-navigation');
    const sectionNav = document.querySelector('.guide-section-nav');
    let expandedHeight = 0;
    let headerFrame = 0;
    const sizeNavigation = () => {
      const headerHeight = siteHeader.getBoundingClientRect().height;
      const secondaryHeight = sectionNav?.getBoundingClientRect().height || 0;
      if (!siteHeader.classList.contains('is-compact')) expandedHeight = Math.max(expandedHeight,headerHeight);
      // Preserve document flow as the visible header shrinks; never pull the hero upward.
      document.documentElement.style.setProperty('--navigation-space', Math.max(0,expandedHeight - headerHeight) + 'px');
      document.documentElement.style.setProperty('--masthead-height', headerHeight + 'px');
      document.documentElement.style.setProperty('--guide-scroll-offset', (headerHeight + secondaryHeight + 16) + 'px');
    };
    const updateHeader = () => {
      headerFrame = 0;
      const compact = window.scrollY > 64 || (siteHeader.classList.contains('is-compact') && window.scrollY > 8);
      siteHeader.classList.toggle('is-compact', compact);
      sizeNavigation();
    };
    const navigationObserver = new ResizeObserver(sizeNavigation);
    navigationObserver.observe(navigation, { box: 'border-box' });
    window.addEventListener('scroll', () => {
      if (!headerFrame) headerFrame = requestAnimationFrame(updateHeader);
    }, { passive: true });
    window.addEventListener('pageshow', updateHeader);
    window.addEventListener('resize', () => {
      // Measure the expanded size without changing the visible header or the scroll position.
      const probe = siteHeader.cloneNode(true);
      probe.classList.remove('is-compact');
      probe.style.cssText = 'position:absolute;visibility:hidden;pointer-events:none;top:0;left:0;right:0';
      navigation.append(probe);
      expandedHeight = probe.getBoundingClientRect().height;
      probe.remove();
      sizeNavigation();
    });
    sizeNavigation();
    updateHeader();
    // Map each source focal point to the upper part of the visible window.
    const crop = image => {
      if (!image.naturalWidth || !image.clientWidth) return;
      const { clientWidth: w, clientHeight: h, naturalWidth: iw, naturalHeight: ih } = image;
      const scale = Math.max(w / iw, h / ih);
      const position = (frame, rendered, focus, anchor) => {
        const travel = rendered - frame;
        if (travel <= 0.01) return 50;
        const offset = Math.max(0, Math.min(travel, rendered * focus - frame * anchor));
        return 100 * offset / travel;
      };
      const x = position(w, iw * scale, Number(image.dataset.focusX), 0.5);
      const y = position(h, ih * scale, Number(image.dataset.focusY), 0.34);
      image.style.objectPosition = x + '% ' + y + '%';
    };
    const observer = new ResizeObserver(entries => entries.forEach(({ target }) => crop(target)));
    document.querySelectorAll('img[data-focus-y]').forEach(image => {
      observer.observe(image);
      image.addEventListener('load', () => crop(image));
      crop(image);
    });
  </script>
</body>
</html>
